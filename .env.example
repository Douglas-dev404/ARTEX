# Configuração do deploy com Docker (copie para .env)
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Atualização por Release privado do GitHub (lido só pelo backend; o token precisa de Contents: read em Hinln/ARTEX)
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM (um dos dois ou ambos; também pode deixar em branco e configurar na UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Optional shared secret for the offline audit runner. Keep empty to disable its API.
ARTEX_AUDIT_RUNNER_TOKEN=
