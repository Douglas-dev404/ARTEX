# claude code local state
.claude/

# Binário único com o frontend embutido
/artex
# Artefatos intermediários deixados ao lado do executável pela atualização com um clique (arquivo em staging / backup / versão com falha / marcador de upgrade)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# Chave de assinatura JWT (gerada em tempo de execução, fica na raiz do projeto, nunca commitar)
/jwt.key

# Ambiente local gerado pelo deploy com Docker (contém senhas/chaves, não commitar)
.env

# Logs de eventos gerados pela execução/simulação do agendador (artefatos de teste, não commitar)
*-events.csv

# Artefatos relacionados ao benchmark bench (locais, não commitar)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# Capturas e saídas do Playwright geradas em QA visual (locais, não commitar)
/ui-*.png
/qa-*.png
/.playwright-mcp/
/web/.playwright-mcp/
